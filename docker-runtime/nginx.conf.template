user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    client_max_body_size 1m;
    server {
        listen ${WEB_LISTEN};
        root /opt/delayer/web;
        set_real_ip_from unix:;
        real_ip_header X-Real-IP;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
        location = /healthz {
            access_log off;
            proxy_pass http://unix:/run/delayer/control.sock:/healthz;
        }
        location /api/ {
            proxy_pass http://unix:/run/delayer/control.sock;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 40s;
        }
        location / {
            try_files $uri $uri/ =404;
        }
    }
}
