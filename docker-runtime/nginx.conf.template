user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    client_max_body_size 16k;
    server {
        listen ${WEB_LISTEN};
        root /opt/delayer/web;
        auth_basic "T-Delayer Control";
        auth_basic_user_file /run/delayer/htpasswd;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'" always;
        location = /healthz {
            auth_basic off;
            access_log off;
            proxy_pass http://unix:/run/delayer/control.sock:/healthz;
        }
        location /api/ {
            proxy_pass http://unix:/run/delayer/control.sock;
            proxy_read_timeout 40s;
            add_header Cache-Control "no-store" always;
        }
        location / { try_files $uri $uri/ =404; }
    }
}
