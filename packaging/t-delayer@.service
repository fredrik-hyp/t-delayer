[Unit]
Description=T-Delayer installation %i, PostgreSQL, and web UI in Docker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
PartOf=docker.service
RequiresMountsFor=/var/lib/t-delayer/installations/%i

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/t-delayerctl start %i --direct
ExecStop=/usr/sbin/t-delayerctl stop %i --direct
TimeoutStartSec=300
TimeoutStopSec=100
UMask=0077

[Install]
WantedBy=multi-user.target
